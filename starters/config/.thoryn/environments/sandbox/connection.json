{
  "apiVersion": "thoryn.io/connection/v1",
  "workspace": {
    "slug": "{{thoryn.workspace}}",
    "hubBaseUrlEnv": "THORYN_ISSUER"
  },
  "auth": {
    "method": "workload_identity",
    "provider": "github_actions",
    "clientId": "{{thoryn.sandboxWorkloadIdentityClientId}}",
    "environment": "{{thoryn.sandboxEnvironment}}",
    "scopes": [
      "tenant:environments.read",
      "tenant:idp.read",
      "tenant:idp.write"
    ],
    "github": {
      "owner": "{{thoryn.githubOwner}}",
      "repository": "{{thoryn.githubRepository}}"
    }
  }
}
