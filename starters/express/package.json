    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "5.2.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "openid-client": "6.8.8"
  }
}
