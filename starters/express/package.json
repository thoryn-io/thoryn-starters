{
  "name": "thoryn-starter-express",
  "version": "1.0.0",
  "private": true,
  "description": "Express web app with Thoryn sign-in (authorization code + PKCE) and a protected API.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
